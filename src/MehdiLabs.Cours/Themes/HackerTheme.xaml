<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Hacker Theme -->
    <Color x:Key="BgMainColor">#0D1117</Color>
    <Color x:Key="BgSidebarColor">#010409</Color>
    <Color x:Key="BgSecondaryColor">#161B22</Color>
    <Color x:Key="FgPrimaryColor">#00FF00</Color>
    <Color x:Key="FgSecondaryColor">#008800</Color>
    <Color x:Key="FgMutedColor">#006600</Color>
    <Color x:Key="FgLightColor">#00DD00</Color>
    <Color x:Key="AccentColor">#00FF00</Color>
    <Color x:Key="AccentHoverColor">#00CC00</Color>
    <Color x:Key="BorderColor">#30363D</Color>
    <Color x:Key="SuccessColor">#00FF00</Color>
    <Color x:Key="WarningColor">#FFFF00</Color>
    <Color x:Key="DangerColor">#FF0000</Color>
    <Color x:Key="PurpleColor">#FF00FF</Color>

    <SolidColorBrush x:Key="BgMainBrush" Color="{StaticResource BgMainColor}"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}"/>
    <SolidColorBrush x:Key="FgPrimaryBrush" Color="{StaticResource FgPrimaryColor}"/>
    <SolidColorBrush x:Key="FgSecondaryBrush" Color="{StaticResource FgSecondaryColor}"/>
    <SolidColorBrush x:Key="FgMutedBrush" Color="{StaticResource FgMutedColor}"/>
    <SolidColorBrush x:Key="FgLightBrush" Color="{StaticResource FgLightColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}"/>

    <sys:String x:Key="ThemeName" xmlns:sys="clr-namespace:System;assembly=mscorlib">hacker</sys:String>

</ResourceDictionary>
