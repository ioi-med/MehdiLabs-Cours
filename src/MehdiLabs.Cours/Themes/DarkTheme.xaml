<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme — Palette MehdiLabs Cours -->
    <Color x:Key="BgMainColor">#1E1E1E</Color>
    <Color x:Key="BgSidebarColor">#252526</Color>
    <Color x:Key="BgSecondaryColor">#333333</Color>
    <Color x:Key="FgPrimaryColor">#FFFFFF</Color>
    <Color x:Key="FgSecondaryColor">#999999</Color>
    <Color x:Key="FgMutedColor">#858585</Color>
    <Color x:Key="FgLightColor">#E0E0E0</Color>
    <Color x:Key="AccentColor">#0A84FF</Color>
    <Color x:Key="AccentHoverColor">#0058D0</Color>
    <Color x:Key="BorderColor">#3C3C3C</Color>
    <Color x:Key="SuccessColor">#32D74B</Color>
    <Color x:Key="WarningColor">#FF9F0A</Color>
    <Color x:Key="DangerColor">#FF453A</Color>
    <Color x:Key="PurpleColor">#BF5AF2</Color>

    <SolidColorBrush x:Key="BgMainBrush" Color="{StaticResource BgMainColor}"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}"/>
    <SolidColorBrush x:Key="FgPrimaryBrush" Color="{StaticResource FgPrimaryColor}"/>
    <SolidColorBrush x:Key="FgSecondaryBrush" Color="{StaticResource FgSecondaryColor}"/>
    <SolidColorBrush x:Key="FgMutedBrush" Color="{StaticResource FgMutedColor}"/>
    <SolidColorBrush x:Key="FgLightBrush" Color="{StaticResource FgLightColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}"/>

    <sys:String x:Key="ThemeName" xmlns:sys="clr-namespace:System;assembly=mscorlib">dark</sys:String>

</ResourceDictionary>
