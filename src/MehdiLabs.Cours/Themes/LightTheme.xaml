<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme -->
    <Color x:Key="BgMainColor">#F5F5F7</Color>
    <Color x:Key="BgSidebarColor">#E5E5EA</Color>
    <Color x:Key="BgSecondaryColor">#FFFFFF</Color>
    <Color x:Key="FgPrimaryColor">#1D1D1F</Color>
    <Color x:Key="FgSecondaryColor">#6E6E73</Color>
    <Color x:Key="FgMutedColor">#8E8E93</Color>
    <Color x:Key="FgLightColor">#3A3A3C</Color>
    <Color x:Key="AccentColor">#0A84FF</Color>
    <Color x:Key="AccentHoverColor">#0063CC</Color>
    <Color x:Key="BorderColor">#D1D1D6</Color>
    <Color x:Key="SuccessColor">#34C759</Color>
    <Color x:Key="WarningColor">#FF9500</Color>
    <Color x:Key="DangerColor">#FF3B30</Color>
    <Color x:Key="PurpleColor">#AF52DE</Color>

    <SolidColorBrush x:Key="BgMainBrush" Color="{StaticResource BgMainColor}"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}"/>
    <SolidColorBrush x:Key="FgPrimaryBrush" Color="{StaticResource FgPrimaryColor}"/>
    <SolidColorBrush x:Key="FgSecondaryBrush" Color="{StaticResource FgSecondaryColor}"/>
    <SolidColorBrush x:Key="FgMutedBrush" Color="{StaticResource FgMutedColor}"/>
    <SolidColorBrush x:Key="FgLightBrush" Color="{StaticResource FgLightColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}"/>

    <sys:String x:Key="ThemeName" xmlns:sys="clr-namespace:System;assembly=mscorlib">light</sys:String>

</ResourceDictionary>
