<Page x:Class="MehdiLabs.Cours.Views.Pages.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:controls="clr-namespace:MehdiLabs.Cours.Views.Controls"
      xmlns:viewmodels="clr-namespace:MehdiLabs.Cours.ViewModels"
      d:DataContext="{d:DesignInstance Type=viewmodels:ChatbotViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Assistant IA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="150"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Historique -->
        <Grid Grid.Column="0" Background="{DynamicResource BgSidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="+ Nouvelle conversation" Style="{StaticResource AccentButton}" 
                    Command="{Binding NewChatCommand}" Margin="15"/>

            <ListBox Grid.Row="1" ItemsSource="{Binding Conversations}" SelectedItem="{Binding CurrentConversation}"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" Grid.Column="0" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="❌" Command="{Binding DataContext.DeleteChatCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                    CommandParameter="{Binding Id}" Background="Transparent" BorderThickness="0" Padding="5,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>

        <!-- Zone Chat -->
        <Grid Grid.Column="2" Background="{DynamicResource BgMainBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header avec Combobox Contexte -->
            <Border Grid.Row="0" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Attacher un cours :" Foreground="{DynamicResource FgSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding AvailableCourses}" SelectedItem="{Binding SelectedCourseForContext}" Width="200" Margin="0,0,10,0"/>
                    <Button Content="Attacher" Style="{StaticResource FlatButton}" Command="{Binding AttachCourseCommand}" Padding="12,4"/>
                </StackPanel>
            </Border>

            <!-- Liste des Messages -->
            <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10">
                <ItemsControl ItemsSource="{Binding CurrentMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ChatBubble Role="{Binding Role}" ContentText="{Binding Content}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Loading Indicator -->
            <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="4" BorderThickness="0" 
                         Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}" 
                         Foreground="{DynamicResource AccentBrush}"/>

            <!-- Input Area -->
            <Border Grid.Row="3" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" AcceptsReturn="True" MaxHeight="120"
                             TextWrapping="Wrap" Margin="0,0,15,0" Tag="Tapez votre message..."/>
                             
                    <Button Grid.Column="1" Content="Envoyer 🚀" Style="{StaticResource AccentButton}" 
                            Command="{Binding SendCommand}" VerticalAlignment="Bottom" Padding="20,10"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
